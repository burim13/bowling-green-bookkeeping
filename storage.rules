rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Set by functions/index.js's syncUserClaims* triggers whenever /users/{uid} or
    // settings/allowlist changes in Firestore. Deliberately NOT using firestore.get() here
    // (the documented pattern for Storage rules reading Firestore) -- it reliably failed for
    // this project even for the simplest possible single-field read, confirmed by bisection
    // testing every account, staff included. Custom claims sidestep the cross-service call
    // entirely: request.auth.token.* is native to Storage rules, no bridge needed.
    function isApproved() {
      return isSignedIn() && request.auth.token.approved == true;
    }

    function isOwningClient(clientId) {
      return isSignedIn() &&
        request.auth.token.role == 'client' &&
        request.auth.token.clientId == clientId;
    }

    // A file the *client's own browser* claims is a 25MB PDF is still just a claim -- Storage
    // enforces request.resource.size/contentType against what it actually received, not
    // whatever the uploader's request headers say, so this isn't just a UI-level restriction
    // (the <input accept="..."> on the upload form is a convenience, not a security boundary).
    function isAllowedDocument() {
      return request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Staff manage everything; the owning client can read their own folder, upload new
    // documents (of a sane type/size only), and delete a document they uploaded -- but only
    // before staff has reviewed it. `reviewed` isn't something Storage rules can read from the
    // Firestore doc directly (that cross-service read is what's broken here -- see isApproved()
    // above), so functions/index.js's syncDocumentReviewedMetadata trigger stamps the same
    // value onto this object's own custom metadata instead, which resource.metadata reads
    // natively.
    match /clients/{clientId}/documents/{allPaths=**} {
      allow read: if isApproved() || isOwningClient(clientId);
      allow create: if (isApproved() || isOwningClient(clientId)) && isAllowedDocument();
      allow update: if isApproved();
      allow delete: if isApproved() ||
        (isOwningClient(clientId) && resource.metadata.reviewed != 'true');
    }

    function isAllowedPdf() {
      return request.resource.size < 25 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }

    // Engagement letters. Each letter has exactly two objects: the staff-uploaded original and
    // the client-produced signed copy (see public/js/letters.js) -- naming them explicitly
    // (rather than one shared {allPaths=**} match) is what lets the client side be write-once:
    // isOwningClient can *create* signed.pdf but never update/delete it afterward, matching the
    // Firestore letters rule's one-way "sent" -> "signed" transition.
    match /clients/{clientId}/letters/{letterId}/original.pdf {
      allow read: if isApproved() || isOwningClient(clientId);
      allow create, update: if isApproved() && isAllowedPdf();
      allow delete: if isApproved();
    }
    match /clients/{clientId}/letters/{letterId}/signed.pdf {
      allow read: if isApproved() || isOwningClient(clientId);
      allow create: if (isApproved() || isOwningClient(clientId)) && isAllowedPdf();
      allow update, delete: if isApproved();
    }

    // Forms library: the shared blank-template files (firm-wide, staff-only) and each client's
    // own copy of one once it's sent to them (functions/index.js's sendFormToClients copies it
    // server-side at send time, via the Admin SDK -- never through these rules, which is why
    // there's no client-facing "create" path for the client's copy below: it's created for them,
    // not by them).
    match /formTemplates/{templateId}/{fileName} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved() && isAllowedPdf();
    }
    match /clients/{clientId}/sentForms/{sentFormId}/blank.pdf {
      allow read: if isApproved() || isOwningClient(clientId);
      allow write: if isApproved();
    }
  }
}
