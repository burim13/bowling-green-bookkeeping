rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Set by functions/index.js's syncUserClaims* triggers whenever /users/{uid} or
    // settings/allowlist changes in Firestore. Deliberately NOT using firestore.get() here
    // (the documented pattern for Storage rules reading Firestore) -- it reliably failed for
    // this project even for the simplest possible single-field read, confirmed by bisection
    // testing every account, staff included. Custom claims sidestep the cross-service call
    // entirely: request.auth.token.* is native to Storage rules, no bridge needed.
    function isApproved() {
      return isSignedIn() && request.auth.token.approved == true;
    }

    function isOwningClient(clientId) {
      return isSignedIn() &&
        request.auth.token.role == 'client' &&
        request.auth.token.clientId == clientId;
    }

    // Staff manage everything; the owning client can read their own folder and upload new
    // documents, but can't overwrite or delete what's already there (matches the create-only
    // client permission on the Firestore documents subcollection in firestore.rules).
    match /clients/{clientId}/documents/{allPaths=**} {
      allow read, create: if isApproved() || isOwningClient(clientId);
      allow update, delete: if isApproved();
    }

    // Generated engagement letters / signed PDFs -- staff-generated only, client can read theirs.
    match /clients/{clientId}/letters/{allPaths=**} {
      allow read: if isApproved() || isOwningClient(clientId);
      allow write: if isApproved();
    }
  }
}
