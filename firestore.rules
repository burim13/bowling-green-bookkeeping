rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // The one costly (extra-read) check, so it's only used where it actually matters.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Every signed-in user (owner + any staff) can read/write everything except one thing:
    // deleting a client outright is admin-only, since it cascades and can't be undone.
    match /clients/{clientId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // The app loads items/completions across ALL clients at once via collectionGroup()
    // queries, not just within one client's subcollection. A nested match under
    // /clients/{id}/items/{id} does NOT authorize collection-group queries -- only this
    // recursive {path=**} wildcard form does. (It still matches direct, non-group access
    // at the same path too, so this fully replaces a nested rule rather than adding to it.)
    match /{path=**}/items/{itemId} {
      allow read, write: if isSignedIn();
    }
    match /{path=**}/completions/{completionId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    // Users can read anyone's doc (nothing sensitive in it) and create/update only their OWN
    // doc -- and never through a change to their own `role`. role always starts as "staff" and
    // can only ever become "admin" via the Firebase console (which uses the Admin SDK and so
    // bypasses these rules entirely). Without this, any signed-in user could self-promote to
    // admin with a single client-side write and delete any client.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'staff';
      allow update: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
    }
  }
}
