rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // The real access-control boundary. Anyone can still technically create a Firebase Auth
    // account (the free Spark plan has no built-in way to block that without Cloud Functions,
    // which need the paid Blaze plan) -- but unless their email is in this list, every single
    // read/write below is denied, so an unapproved account can't touch any real data.
    //
    // Manage this directly in the Firestore console: Data tab -> settings -> allowlist ->
    // edit the `emails` array. IMPORTANT: this document must exist (with your own email in it)
    // BEFORE you publish these rules, or you'll lock yourself out too -- see README.
    function isApproved() {
      return isSignedIn() &&
        request.auth.token.email in get(/databases/$(database)/documents/settings/allowlist).data.emails;
    }

    // The one extra-costly check (on top of isApproved's own lookup), so it's only used where
    // it actually matters.
    function isAdmin() {
      return isApproved() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Client Hub: a client-role user (created manually by staff via the console, same as the
    // admin-promotion flow -- there's no client self-signup) can only ever touch their own
    // client's subtree, identified by the clientId on their own /users/{uid} doc.
    function isOwningClient(clientId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId;
    }

    // Every approved user (owner + any approved staff) can read/write everything except one
    // thing: deleting a client outright is admin-only, since it cascades and can't be undone.
    // A client-role user may additionally read (never write) their own client record.
    match /clients/{clientId} {
      allow read: if isApproved() || isOwningClient(clientId);
      allow create, update: if isApproved();
      allow delete: if isAdmin();

      // Client Hub subcollections. Staff manage everything; the owning client can read
      // everything in their own folder and upload documents, but letters/signature requests
      // are staff-generated only.
      match /documents/{docId} {
        allow read, create: if isApproved() || isOwningClient(clientId);
        allow update: if isApproved();
        // The owning client can delete their own upload, but only before staff has reviewed
        // it -- fixes an accidental upload without letting a document staff already acted on
        // quietly disappear. resource.data is the doc as it exists NOW (pre-delete), so this
        // reads the current reviewed value, not anything the request could try to set.
        allow delete: if isApproved() || (isOwningClient(clientId) && resource.data.reviewed == false);
      }
      match /letters/{letterId} {
        allow read: if isApproved() || isOwningClient(clientId);
        allow write: if isApproved();
      }
      match /signatureRequests/{requestId} {
        allow read: if isApproved() || isOwningClient(clientId);
        allow write: if isApproved();
      }

      // Read-only view of a client's own compliance items/completions, for the Client Hub
      // "Compliance" tab. This is ADDITIONAL to (not a replacement for) the {path=**} wildcard
      // rules below -- Firestore grants access if ANY matching rule block allows it, and a
      // nested match like this one only ever authorizes direct/scoped reads at this exact path
      // shape (never collection-group queries), so it can't broaden staff's existing access.
      // A client's own app code queries these paths directly (never collectionGroup), matching
      // this shape exactly -- see public/js/client-compliance.js.
      match /items/{itemId} {
        allow read: if isOwningClient(clientId);
        match /completions/{completionId} {
          allow read: if isOwningClient(clientId);
        }
      }
    }

    // The app loads items/completions across ALL clients at once via collectionGroup()
    // queries, not just within one client's subcollection. A nested match under
    // /clients/{id}/items/{id} does NOT authorize collection-group queries -- only this
    // recursive {path=**} wildcard form does. (It still matches direct, non-group access
    // at the same path too, so this fully replaces a nested rule rather than adding to it.)
    match /{path=**}/items/{itemId} {
      allow read, write: if isApproved();
    }
    match /{path=**}/completions/{completionId} {
      allow read, write: if isApproved();
    }

    match /settings/{docId} {
      allow read, write: if isApproved();
    }

    // Users can read anyone's doc (nothing sensitive in it) and create/update only their OWN
    // doc -- and never through a change to their own `role`. role always starts as "staff" and
    // can only ever become "admin" via the Firebase console (which uses the Admin SDK and so
    // bypasses these rules entirely). Without this, any approved user could self-promote to
    // admin with a single client-side write and delete any client.
    match /users/{uid} {
      // Anyone signed in can read their own doc -- a client-role user needs this at login to
      // find out they're a client (and which clientId) before isApproved() would ever be true
      // for them. Approved staff can still read anyone's doc (nothing sensitive in it).
      allow read: if isApproved() || request.auth.uid == uid;
      allow create: if isApproved() && request.auth.uid == uid && request.resource.data.role == 'staff';

      // Self-service signup, but ONLY into a role/clientId a staff member already committed to
      // by creating the matching /clientInvites/{token} doc below. The client picks the token
      // (it's in the URL staff sent them) and the clientId (also in that URL, for convenience)
      // -- but this rule re-derives clientId from the invite doc itself, so a tampered or
      // made-up clientId in the write is simply rejected, never trusted from the request alone.
      // This is the only way a `role: "client"` doc can ever be created -- there is no
      // equivalent path for `role: "staff"` or `"admin"` via self-signup.
      allow create: if request.auth.uid == uid &&
        request.resource.data.role == 'client' &&
        request.resource.data.keys().hasOnly(['role', 'clientId', 'inviteToken', 'email', 'createdAt']) &&
        get(/databases/$(database)/documents/clientInvites/$(request.resource.data.inviteToken)).data.used == false &&
        get(/databases/$(database)/documents/clientInvites/$(request.resource.data.inviteToken)).data.clientId == request.resource.data.clientId;

      allow update: if isApproved() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
    }

    // Invite links staff sends to clients. Not readable by the invitee (the invite page never
    // needs to read this doc -- it just attempts the account-creation write and lets that
    // succeed or fail) -- but staff CAN read these, to see whether functions/index.js's
    // sendClientInvite actually delivered the email (emailSentAt/emailError) or whether it's
    // still sitting unused.
    match /clientInvites/{token} {
      allow read: if isApproved();
      allow create, delete: if isApproved();

      // Marking an invite used happens right after the matching user doc was created (see
      // public/js/invite.js) -- allowed only by the exact account that invite was just consumed
      // into, and only turning used false -> true, never back.
      allow update: if isSignedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == resource.data.clientId;
    }
  }
}
