rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // The one costly (extra-read) check, so it's only used where it actually matters.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Every signed-in user (owner + any staff) can read/write everything except one thing:
    // deleting a client outright is admin-only, since it cascades and can't be undone.
    match /clients/{clientId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read, write: if isSignedIn();

        match /completions/{completionId} {
          allow read, write: if isSignedIn();
        }
      }
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }
  }
}
